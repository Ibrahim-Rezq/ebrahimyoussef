---
import { SITE } from '../data/site';
---

<section id="services" class="section section-contrast" aria-labelledby="services-title">
  <div class="wrap services-layout">
    <div class="services-heading">
      <p class="eyebrow">Services</p>
      <h2 id="services-title" class="section-heading">How I can help</h2>
      <p>Bring me a product idea, a website that is not doing its job, or a front end that needs a dependable pair of hands.</p>
    </div>
    <div class="service-list">
      {SITE.services.map((service) => (
        <article>
          <h3>{service.name}</h3>
          <p>{service.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-layout { display: grid; grid-template-columns: minmax(16rem, .8fr) minmax(20rem, 1.2fr); gap: clamp(3rem, 8vw, 8rem); }
  .services-heading { align-self: start; position: sticky; top: 2rem; }
  .services-heading > p:last-child { max-width: 42ch; color: var(--ink-soft); }
  .service-list { border-top: 1px solid var(--line-strong); }
  article { padding-block: 2rem; border-bottom: 1px solid var(--line-strong); }
  h3 { margin: 0 0 .65rem; font-size: var(--step-2); }
  article p { max-width: 49ch; margin: 0; color: var(--ink-soft); }
  @media (max-width: 44rem) { .services-layout { grid-template-columns: 1fr; } .services-heading { position: static; } }
</style>
