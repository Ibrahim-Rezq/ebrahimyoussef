---
import Arabesque from './Arabesque.astro';
import { SITE } from '../data/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <Arabesque variant="tile" />
  <div class="wrap contact-inner">
    <p class="eyebrow">Have a project in mind?</p>
    <h2 id="contact-title">Let’s make the next version real.</h2>
    <p>Tell me what you are building, who it needs to help, and where the current experience is getting in the way.</p>
    <div class="contact-actions">
      <a class="button button-primary" href={SITE.emailUrl}>Email me about a project</a>
      <a class="button button-secondary" href={SITE.bookingUrl}>Book a call</a>
    </div>
  </div>
</section>

<style>
  .contact { position: relative; overflow: hidden; border-top: 1px solid var(--line); text-align: center; }
  .contact-inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
  h2 { max-width: 14ch; margin: 0; font-size: var(--step-5); letter-spacing: -.05em; line-height: 1; text-wrap: balance; }
  .contact-inner > p:not(.eyebrow) { max-width: 48ch; color: var(--ink-soft); font-size: var(--step-1); }
  .contact-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; margin-top: 1.5rem; }
  :global(.contact > .ey-arabesque-tile) { opacity: .035; }
  @media (max-width: 30rem) { .contact-actions, .contact-actions .button { width: 100%; } }
</style>
