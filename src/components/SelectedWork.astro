---
import { products } from '../data/products';
const featured = products.filter((product) => product.featured);
---

<section id="work" class="section section-rule" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-intro">
      <p class="eyebrow">Proof, not promises</p>
      <h2 id="work-title" class="section-heading">Selected work</h2>
      <p>Products that show how I think through real constraints, from an Arabic-first daily experience to a typed developer tool.</p>
    </div>
    <div class="work-list">
      {featured.map((product, index) => (
        <article class="work-item">
          <div class="work-index" aria-hidden="true">0{index + 1}</div>
          <div class="work-main">
            <p class="work-label">{product.label}</p>
            <h3>{product.name}</h3>
            <p class="work-problem">{product.problem}</p>
          </div>
          <div class="work-detail">
            <p><strong>What I built</strong>{product.contribution}</p>
            <p><strong>Current result</strong>{product.result}</p>
            <div class="work-actions">
              <a href={product.href} target="_blank" rel="noopener noreferrer">{product.cta} ↗</a>
              <a href={product.repo} target="_blank" rel="noopener noreferrer">View source</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-intro { display: grid; grid-template-columns: minmax(12rem, .7fr) 1.3fr; gap: .5rem 3rem; align-items: end; margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }
  .section-intro .eyebrow { grid-column: 1 / -1; }
  .section-intro p:last-child { max-width: 50ch; margin: 0; color: var(--ink-soft); }
  .work-list { border-top: 1px solid var(--line-strong); }
  .work-item { display: grid; grid-template-columns: 3rem minmax(13rem, .8fr) minmax(18rem, 1.2fr); gap: clamp(1rem, 3vw, 3rem); padding-block: clamp(2rem, 5vw, 3.5rem); border-bottom: 1px solid var(--line-strong); }
  .work-index, .work-label { color: var(--terra-deep); font: 650 .76rem/1 var(--font-utility); letter-spacing: .08em; text-transform: uppercase; }
  .work-label { margin: 0 0 .8rem; }
  h3 { margin: 0; font-size: var(--step-3); letter-spacing: -.035em; }
  .work-problem { max-width: 38ch; margin: 1rem 0 0; color: var(--ink-soft); }
  .work-detail p { margin: 0 0 1rem; color: var(--ink-soft); }
  .work-detail strong { display: block; margin-bottom: .2rem; color: var(--ink); font-size: .82rem; }
  .work-actions { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 1.5rem; }
  .work-actions a { color: var(--ink); font-weight: 650; text-underline-offset: .35rem; }
  @media (max-width: 48rem) {
    .section-intro { grid-template-columns: 1fr; }
    .work-item { grid-template-columns: 2rem 1fr; }
    .work-detail { grid-column: 2; }
  }
  @media (max-width: 28rem) { .work-item { grid-template-columns: 1fr; } .work-index { display: none; } .work-detail { grid-column: 1; } }
</style>
