---
import { SITE } from '../data/site';
---

<section id="process" class="section" aria-labelledby="process-title">
  <div class="wrap">
    <p class="eyebrow">A clear path forward</p>
    <h2 id="process-title" class="section-heading process-title">How we get from idea to launch</h2>
    <ol class="process-list">
      {SITE.process.map((step, index) => (
        <li>
          <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.name}</h3>
          <p>{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-title { max-width: 15ch; }
  .process-list { display: grid; grid-template-columns: repeat(4, 1fr); margin: 3.5rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  li { position: relative; padding: 2rem 1.5rem 0 0; border-right: 1px solid var(--line); }
  li + li { padding-left: 1.5rem; }
  li:last-child { border-right: 0; }
  .step-number { display: block; margin-bottom: 3.5rem; color: var(--terra-deep); font: 650 .78rem/1 var(--font-utility); }
  h3 { margin: 0 0 .65rem; font-size: var(--step-1); }
  li p { margin: 0; color: var(--ink-soft); font-size: .95rem; }
  @media (max-width: 48rem) { .process-list { grid-template-columns: repeat(2, 1fr); } li { padding-bottom: 2rem; } .step-number { margin-bottom: 1.5rem; } }
  @media (max-width: 28rem) { .process-list { grid-template-columns: 1fr; } li, li + li { padding: 1.5rem 0; border-right: 0; border-bottom: 1px solid var(--line); } .step-number { margin-bottom: .8rem; } }
</style>
