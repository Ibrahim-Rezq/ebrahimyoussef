---
import Monogram from './Monogram.astro';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand"><Monogram size={32} /><span>{SITE.name}</span></div>
    <p>© {year} · Built with Astro, without trackers.</p>
    <nav aria-label="Footer links">
      <a href={SITE.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={SITE.emailUrl}>Email</a>
    </nav>
  </div>
</footer>

<style>
  .footer { padding-block: 1.5rem; border-top: 1px solid var(--line); }
  .footer-inner, .footer-brand, nav { display: flex; align-items: center; }
  .footer-inner { justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; }
  .footer-brand { gap: .65rem; font-weight: 650; }
  p { margin: 0; color: var(--ink-soft); font-size: .82rem; }
  nav { gap: 1rem; }
  nav a { color: var(--ink); font-size: .82rem; text-underline-offset: .3rem; }
</style>
