---
import Monogram from './Monogram.astro';
import Arabesque from './Arabesque.astro';
import { SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <Arabesque variant="tile" />
  <div class="wrap footer-inner">
    <div class="footer-mark">
      <Monogram size={32} title="Ebrahim Youssef" />
      <p class="footer-line">© {year} Ebrahim Youssef · Built with Astro — no trackers.</p>
    </div>
    <nav class="footer-links" aria-label="Footer links">
      <a href={SITE.socials.github} rel="noopener" target="_blank">GitHub</a>
      <a href={`mailto:${SITE.email}`}>Email</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-block: 2.5rem 2rem;
  }
  .footer-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-line {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
  }
  :global(.ey-arabesque-tile) {
    opacity: 0.04;
  }
</style>
