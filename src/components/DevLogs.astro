---
import { SITE } from '../data/site';
---

<section id="devlogs" class="section">
  <div class="wrap">
    <h2 class="section-title">Dev-logs</h2>
    <div class="card devlogs-card">
      <p class="devlogs-text">
        Coming soon — build notes from NABD, the Quran API, and this site. Until then, I post every other day:&nbsp;
        <a href={SITE.socials.linkedin} rel="noopener">LinkedIn</a>,&nbsp;
        <a href={SITE.socials.qabilah} rel="noopener">Qabilah</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .devlogs-card {
    background: var(--surface);
  }
  .devlogs-text {
    margin: 0;
    color: var(--ink-soft);
  }
</style>
